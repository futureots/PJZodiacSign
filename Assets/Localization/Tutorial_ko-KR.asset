  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: Tutorial_ko-KR
  m_EditorClassIdentifier: Unity.Localization::UnityEngine.Localization.Tables.StringTable
  m_LocaleId:
    m_Code: ko-KR
  m_SharedData: {fileID: 11400000, guid: 2f862b38179f89e479e5ab79b325af43, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 106497187840
    m_Localized: "\uC0C1\uC810\uC5D0\uC11C \uD06C\uB808\uB527\uC744 \uC0AC\uC6A9\uD574
      \uAE30\uBB3C\uACFC \uC544\uC774\uD15C\uC744 \uAD6C\uB9E4\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\n\uAE30\uBB3C\uC774\uB098
      \uC544\uC774\uD15C\uC758 \uC544\uC774\uCF58\uC744 \uD074\uB9AD\uD558\uC5EC
      \uC2A4\uD0AC\uC758 \uD6A8\uACFC \uBC0F \uBC94\uC704\uB97C \uD655\uC778\uD560
      \uC218 \uC788\uC2B5\uB2C8\uB2E4. \n\uC544\uC774\uCF58\uC744 \uB2E4\uC2DC \uD074\uB9AD\uD558\uBA74
      \uC0AC\uB77C\uC9D1\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 106597851136
    m_Localized: "\uAD6C\uB9E4\uD55C \uAE30\uBB3C\uC740 \uC0C1\uC810 \uC544\uB798
      \uD544\uB4DC\uC5D0,\n\uAD6C\uB9E4\uD55C \uC544\uC774\uD15C\uC740 \uC67C\uCABD
      \uC778\uBCA4\uD1A0\uB9AC\uC5D0 \uCD94\uAC00\uB429\uB2C8\uB2E4.\n\uD544\uB4DC\uAC00
      \uAC00\uB4DD \uCC28\uAC70\uB098, \uC778\uBCA4\uD1A0\uB9AC\uAC00 \uAC00\uB4DD
      \uCC30 \uACBD\uC6B0 \uCD94\uAC00\uB85C \uAE30\uBB3C\uACFC \uC544\uC774\uD15C\uC744
      \uAD6C\uB9E4\uD560 \uC218 \uC5C6\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 106597851137
    m_Localized: "\uBC30\uCE58 \uAD6C\uC5ED\uC758 \uAE30\uBB3C\uC744 \uB4DC\uB798\uADF8&\uB4DC\uB86D\uD558\uC5EC
      \uD544\uB4DC\uC5D0 \uBC30\uCE58\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4. (\uCD08\uB85D\uD0C0\uC77C
      \uC704\uC5D0\uB9CC \uBC30\uCE58 \uAC00\uB2A5)\n\uC870\uC885 \uAC00\uB2A5\uD55C
      \uAE30\uBB3C\uC740 \uB808\uBCA8 \uD328\uB110\uC774 \uCD08\uB85D\uC0C9\uC73C\uB85C
      \uD45C\uC2DC\uB429\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 106597851138
    m_Localized: "\uAE30\uBB3C\uC744 \uAC19\uC740 \uB808\uBCA8\uC758 \uB3D9\uC77C\uD55C
      \uAE30\uBB3C\uC5D0 \n\uACB9\uCE60 \uACBD\uC6B0 \uAE30\uBB3C\uC744 \uC18C\uBAA8\uD558\uC5EC\n\uAC15\uD654\uD560
      \uC218 \uC788\uC2B5\uB2C8\uB2E4.\n\uB610\uB294 \uAC15\uD654 \uC544\uC774\uD15C\uC744
      \uC0AC\uC6A9\uD558\uC5EC \uAE30\uBB3C \uC18C\uBAA8 \uC5C6\uC774 \uAC15\uD654\uD560
      \uC218 \uC788\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 106602045440
    m_Localized: "\uD544\uB4DC\uC5D0 \uC124\uCE58\uD560 \uC218 \uC788\uB294 \uAE30\uBB3C\uC758
      \uCD5C\uB300 \uAC1C\uC218\uAC00 \uC874\uC7AC\uD569\uB2C8\uB2E4. \n\uAC1C\uC218
      \uC81C\uD55C\uC5D0 \uC8FC\uC758\uD558\uC5EC \uB371\uC744 \uAD6C\uC131\uD558\uC2DC\uAE38
      \uBC14\uB78D\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 106602045441
    m_Localized: "\uC801 \uAE30\uBB3C\uC744 \uC120\uD0DD\uD558\uC5EC \uC801\uC758
      \uACF5\uACA9\uBC94\uC704\uC640 \uC774\uB3D9\uBC94\uC704\uB97C \uD655\uC778\uD560
      \uC218 \uC788\uC2B5\uB2C8\uB2E4.\n\uACF5\uACA9\uBC94\uC704\uB294 \uBE68\uAC04\uC0C9
      \uBE57\uAE08\uC73C\uB85C \uD45C\uC2DC\uB418\uBA70, \uC774\uB3D9\uBC94\uC704\uB294
      \uD30C\uB780\uC0C9\uC73C\uB85C \uD45C\uC2DC\uB429\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 106602045442
    m_Localized: "\uBAA8\uB4E0 \uC900\uBE44\uAC00 \uC644\uB8CC\uB418\uBA74 \uC815\uBE44
      \uC885\uB8CC \uBC84\uD2BC\uC744 \uB20C\uB7EC \uC804\uD22C\uB97C \uC9C4\uD589\uD560
      \uC218 \uC788\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 106602045443
    m_Localized: "\uB9E4 \uD134 \uC2DC\uC791 \uC2DC 3\uC758 \uD589\uB3D9\uB825\uC744
      \uC0AC\uC6A9\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\n\uAE30\uBB3C\uC758 \uC774\uB3D9,
      \uC2A4\uD0AC, \uC544\uC774\uD15C \uC0AC\uC6A9\uC740 \uBAA8\uB450 \uD589\uB3D9\uB825\uC744
      1 \uC18C\uBAA8\uD569\uB2C8\uB2E4.\n\uD589\uB3D9\uB825\uC774 \uBAA8\uB450 \uC18C\uBAA8\uB420
      \uACBD\uC6B0 \uC790\uB3D9\uC73C\uB85C \uD134\uC774 \uC885\uB8CC\uB429\uB2C8\uB2E4.\n\uD589\uB3D9\uB825\uC744
      \uBAA8\uB450 \uC18C\uBAA8\uD558\uC9C0 \uC54A\uC544\uB3C4 \uC218\uB3D9\uC73C\uB85C
      \uD134\uC744 \uC885\uB8CC\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 106602045444
    m_Localized: "\uD544\uB4DC\uC5D0 \uBC30\uCE58\uD55C \uAE30\uBB3C\uC744 \uB4DC\uB798\uADF8&\uB4DC\uB86D\uD574
      \uC774\uB3D9\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\n\uAE30\uBB3C\uC758 \uC774\uB3D9\uBC94\uC704\uB294
      \uCD08\uB85D\uC0C9\uC73C\uB85C \uD45C\uC2DC\uB418\uBA70, \uCD08\uB85D\uC0C9
      \uD0C0\uC77C \uC704\uB85C\uB9CC \uC774\uB3D9\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\n\uAE30\uBB3C
      \uC774\uB3D9 \uC2DC \uC608\uC0C1 \uACF5\uACA9\uBC94\uC704\uAC00 \uC8FC\uD669\uC0C9
      \uBE57\uAE08\uC73C\uB85C \uD45C\uC2DC\uB429\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 106602045445
    m_Localized: "\uAE30\uBB3C\uC758 \uB9C8\uB098\uAC00 \uAC00\uB4DD \uCC3C\uC744
      \uACBD\uC6B0 \uC2A4\uD0AC\uC744 \uC0AC\uC6A9\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\n\uCD08\uB85D\uC0C9
      \uC678\uACFD\uC120\uC774 \uADF8\uB824\uC9C4 \uAE30\uBB3C\uC774\uB098, \uCD08\uB85D\uC0C9
      \uD0C0\uC77C\uC744 \uC120\uD0DD\uD558\uC5EC \uB300\uC0C1\uC744 \uC9C0\uC815\uD560
      \uC218 \uC788\uC2B5\uB2C8\uB2E4.\n\uC2A4\uD0AC\uC744 \uC0AC\uC6A9\uD558\uBA74
      \uAE30\uBB3C\uC758 \uB9C8\uB098\uB294 0\uC73C\uB85C \uCD08\uAE30\uD654 \uB429\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 106602045446
    m_Localized: "\uC778\uBCA4\uD1A0\uB9AC\uC758 \uC544\uC774\uD15C\uC744 \uD074\uB9AD\uD574
      \uC544\uC774\uD15C\uC744 \uC0AC\uC6A9\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4.
      \n\uAE30\uBB3C\uC758 \uC2A4\uD0AC\uACFC \uB3D9\uC77C\uD55C \uBC29\uC2DD\uC73C\uB85C
      \uB300\uC0C1\uC744 \uC9C0\uC815\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\n\uC544\uC774\uD15C\uC744
      \uC0AC\uC6A9\uD558\uBA74 \uD574\uB2F9 \uC544\uC774\uD15C\uC744 \uC778\uBCA4\uD1A0\uB9AC\uC5D0\uC11C
      \uC18C\uBAA8\uB429\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 106602045447
    m_Localized: "\uD134 \uC885\uB8CC \uC2DC \uC790\uC2E0\uC758 \uBAA8\uB4E0 \uAE30\uBB3C\uC774
      \uACF5\uACA9\uC744 1\uD68C \uC9C4\uD589\uD569\uB2C8\uB2E4. \n\uC774\uD6C4 \uAC19\uC740
      \uBC29\uC2DD\uC73C\uB85C \uC801\uC758 \uD134\uC774 \uC9C4\uD589 \uB429\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 106602045448
    m_Localized: "\uC77C\uC815 \uD134\uC774 \uC9C0\uB0A0 \uACBD\uC6B0 \uC804\uD22C\uAC00
      \uC885\uB8CC\uB418\uACE0 \uC815\uC0B0\uC744 \uC9C4\uD589\uD569\uB2C8\uB2E4.\n\uD544\uB4DC\uC5D0
      \uB0A8\uC544\uC788\uB294 \uAE30\uBB3C\uC758 \uAC00\uACA9\uACFC \uB808\uBCA8\uC744
      \uACC4\uC0B0\uD558\uC5EC \uC2B9\uD328\uB97C \uACB0\uC815\uD569\uB2C8\uB2E4.\n\uBA87
      \uD134 \uC774\uD6C4 \uC815\uC0B0\uBC84\uD2BC\uC774 \uD65C\uC131\uD654\uB418\uBA70,
      \uC218\uB3D9\uC73C\uB85C \uC815\uC0B0\uC744 \uC9C4\uD589\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 106602045449
    m_Localized: "\uAE30\uBB3C\uC744 \uC774\uB3D9\uD558\uACE0 \uC2A4\uD0AC\uC744
      \uC0AC\uC6A9\uD574\uC11C \n\uC801\uC744 \uBAA8\uB450 \uC4F0\uB7EC\uD2B8\uB9BD\uC2DC\uB2E4!"
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
