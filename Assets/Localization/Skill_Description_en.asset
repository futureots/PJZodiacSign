  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: Skill_Description_en
  m_EditorClassIdentifier: Unity.Localization::UnityEngine.Localization.Tables.StringTable
  m_LocaleId:
    m_Code: en
  m_SharedData: {fileID: 11400000, guid: 9b7aa5fdd506c8342af5b2c105600032, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 4644984524814
    m_Localized: (Preparation Phase Only) Select a piece to permanently increase
      its level by 1.
    m_Metadata:
      m_Items: []
  - m_Id: 4644984524815
    m_Localized: Deals damage equal to 25% of Max HP to all pieces.
    m_Metadata:
      m_Items: []
  - m_Id: 4644984524816
    m_Localized: Select a piece. Fully restores its HP.
    m_Metadata:
      m_Items: []
  - m_Id: 4644984524817
    m_Localized: Select a piece. Fully restores its Mana.
    m_Metadata:
      m_Items: []
  - m_Id: 4644984524818
    m_Localized: Select a piece. Reduces its Defense by 2.
    m_Metadata:
      m_Items: []
  - m_Id: 4644984524819
    m_Localized: Select a piece. Increases its Defense by 1.
    m_Metadata:
      m_Items: []
  - m_Id: 4644984524820
    m_Localized: Reduces Defense of all pieces by 1. Increases their Attack Power
      by 1.
    m_Metadata:
      m_Items: []
  - m_Id: 4644984524821
    m_Localized: Select a piece. Instantly triggers its skill. The skill target is
      chosen at random.
    m_Metadata:
      m_Items: []
  - m_Id: 4644984524822
    m_Localized: Select a piece. Reduces its Max Mana by 1.
    m_Metadata:
      m_Items: []
  - m_Id: 4644984524823
    m_Localized: Select a piece. Select a tile. Moves the piece to that location.
    m_Metadata:
      m_Items: []
  - m_Id: 4644984524824
    m_Localized: Select a piece. Attacks immediately once.
    m_Metadata:
      m_Items: []
  - m_Id: 276483698790400
    m_Localized: Increases own level by 1. Increases max Mana by 1.
    m_Metadata:
      m_Items: []
  - m_Id: 276483757510656
    m_Localized: Select an ally piece. Transforms into that piece while retaining
      own level.
    m_Metadata:
      m_Items: []
  - m_Id: 276483757510657
    m_Localized: Deals damage equal to 2x current HP to all pieces within skill range.
      Reduces own HP to 1.
    m_Metadata:
      m_Items: []
  - m_Id: 276483757510658
    m_Localized: Select an enemy piece. Attacks it once and reduces its Defense by
      1.
    m_Metadata:
      m_Items: []
  - m_Id: 276483761704960
    m_Localized: Restores 2 Mana to all allies within skill range.
    m_Metadata:
      m_Items: []
  - m_Id: 276483761704961
    m_Localized: Restores HP equal to 2x Attack Power to all allies within skill
      range.
    m_Metadata:
      m_Items: []
  - m_Id: 276483761704962
    m_Localized: Reduces the Attack Power of all enemies within attack range by 1.
    m_Metadata:
      m_Items: []
  - m_Id: 276483761704963
    m_Localized: Attacks enemies within attack range. Deals identical damage and
      reduces Defense by 1 for all enemies within skill range around the target.
    m_Metadata:
      m_Items: []
  - m_Id: 276483761704964
    m_Localized: Select an ally piece. Increases its Defense by 1 and swaps positions
      with it.
    m_Metadata:
      m_Items: []
  - m_Id: 276483761704965
    m_Localized: Select a tile within movement range. Summons an obstacle at that
      location.
    m_Metadata:
      m_Items: []
  - m_Id: 276483761704966
    m_Localized: All ally Unicorns attack immediately. Transforms 1 ally Knight into
      a Unicorn.
    m_Metadata:
      m_Items: []
  - m_Id: 276483761704967
    m_Localized: Increases the Attack Power of all allies within skill range by 1.
    m_Metadata:
      m_Items: []
  - m_Id: 276483761704968
    m_Localized: Deals damage equal to 5x spent Mana to enemies within attack range.
    m_Metadata:
      m_Items: []
  - m_Id: 276483761704969
    m_Localized: Select a tile within movement range to summon a random piece. After
      5 casts, all subsequently summoned pieces have their level increased by 1.
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
