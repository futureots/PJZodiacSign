  m_TableData:
  - m_Id: 1605015900160
    m_Localized: "\uC7AC\uC2DC\uC791|\uD544\uB4DC\uC5D0 \uC874\uC7AC\uD558\uB294
      \uBAA8\uB4E0 \uAE30\uBB3C\uC744 \uC81C\uAC70\uD558\uACE0, \uD06C\uB808\uB527\uC73C\uB85C
      \uB3CC\uB824\uBC1B\uC2B5\uB2C8\uB2E4. \uC774\uD6C4 \uAC00\uC9C4 \uD06C\uB808\uB527\uC744
      2\uBC30\uB85C \uB9CC\uB4ED\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1605099786240
    m_Localized: "\uCC9C\uC0AC \uAC15\uB9BC|\uCC9C\uC0AC\uB97C 1\uAC1C \uD68D\uB4DD\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1605099786241
    m_Localized: "\uC9C0\uD61C|\uCD5C\uB300 \uD589\uB3D9 \uCE74\uC6B4\uD2B8\uAC00
      1 \uC99D\uAC00\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1605099786242
    m_Localized: "\uC5F0\uAE08\uC220\uC0AC|\uC989\uC2DC \uBC0F \uB9E4 \uC2A4\uD14C\uC774\uC9C0
      \uC2DC\uC791 \uC2DC \uB79C\uB364\uD55C \uC544\uC774\uD15C\uC744 1\uAC1C \uD68D\uB4DD\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1605103980544
    m_Localized: "\uAE30\uC6B4 \uCDA9\uB9CC|\uC804\uD22C \uC2DC\uC791 \uC2DC \uBAA8\uB4E0
      \uC544\uAD70\uC758 \uB9C8\uB098\uB97C \uCD5C\uB300\uB85C \uD68C\uBCF5\uC2DC\uD0B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1605103980545
    m_Localized: "\uBD80\uBD80|\uC989\uC2DC \uD0B9\uACFC \uD038\uC744 1\uAC1C\uC529
      \uD68D\uB4DD\uD569\uB2C8\uB2E4. \uB9E4 \uD134 \uC2DC\uC791 \uC2DC \uB79C\uB364\uD55C
      \uD0B9\uACFC \uD038 1\uAC1C\uC758 \uB9C8\uB098\uB97C 1 \uD68C\uBCF5\uC2DC\uD0B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1605103980546
    m_Localized: "\uC804\uD22C\uC758 \uD568\uC131|\uB9E4 \uD134 \uC2DC\uC791 \uC2DC
      \uB79C\uB364 \uC544\uAD70 2\uBA85\uC758 \uACF5\uACA9\uB825\uC744 1 \uC99D\uAC00\uC2DC\uD0B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1605103980547
    m_Localized: "\uD68C\uBCF5\uC758 \uC624\uB77C|\uB9E4 \uD134 \uC2DC\uC791 \uC2DC
      \uBAA8\uB4E0 \uC544\uAD70\uC758 \uCCB4\uB825\uC744 1 \uD68C\uBCF5\uC2DC\uD0B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1605103980548
    m_Localized: "\uC2E0\uBE44\uB85C\uC6B4 \uB300\uC9C0|\uB9E4 \uD134 \uC2DC\uC791
      \uC2DC \uB79C\uB364 \uC544\uAD70 1\uBA85\uC758 \uB9C8\uB098\uB97C 1 \uD68C\uBCF5\uC2DC\uD0B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1605103980549
    m_Localized: "\uC624\uC5FC\uB41C \uB300\uC9C0|\uB9E4 \uD134 \uC2DC\uC791 \uC2DC
      \uBAA8\uB4E0 \uAE30\uBB3C\uC758 \uCCB4\uB825\uC744 1 \uAC10\uC18C\uC2DC\uD0B5\uB2C8\uB2E4.
      \uC801\uAD70\uC740 2 \uAC10\uC18C\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1605103980550
    m_Localized: "\uC784\uC2DC \uC9C4\uAE09|\uC804\uD22C \uC2DC\uC791 \uC2DC \uB79C\uB364
      \uC544\uAD70 3\uBA85\uC758 \uB808\uBCA8\uC744 1 \uC99D\uAC00\uC2DC\uD0B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 317407338369024
    m_Localized: "\uC801\uAE08|\uC989\uC2DC 50\uD06C\uB808\uB527\uC744 \uD68D\uB4DD\uD569\uB2C8\uB2E4.
      \uC774\uD6C4 \uB9E4 \uB808\uBCA8\uB9C8\uB2E4 20\uD06C\uB808\uB527\uC744 \uCD94\uAC00\uB85C
      \uD68D\uB4DD\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 317407405477888
    m_Localized: "\uBCF4\uBB3C|\uC989\uC2DC 150\uD06C\uB808\uB527\uC744 \uD68D\uB4DD\uD569\uB2C8\uB2E4."
