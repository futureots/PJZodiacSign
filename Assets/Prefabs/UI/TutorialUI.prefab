  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 01b2198988f84b142a68be2a2a8b336d, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::TutorialUI
  repairTutorial: {fileID: 0}
  battleTutorial: {fileID: 0}
  description: {fileID: 4930239986288736705}
  repairDescription: "- \uAE30\uBB3C\uC744 \uD074\uB9AD\uD574 \uAE30\uBB3C\uC758
    \uC815\uBCF4\uB97C \uD655\uC778\uD560 \uC218 \uC788\uB2E4.\n- \uC774\uB3D9 :
    \uAE30\uBB3C\uC744 \uB4DC\uB798\uADF8\uD55C\uB2E4.\n- \uB3D9\uC77C\uD55C \uB808\uBCA8\uC758
    \uAC19\uC740 \uAE30\uBB3C\uC744 \uACB9\uCCD0 \uAC15\uD654\uD560 \uC218 \uC788\uB2E4.
    \uAC15\uD654 \uC2DC \uC7AC\uB8CC \uAE30\uBB3C\uC740 \uC0AC\uB77C\uC9C4\uB2E4.\n-
    \uC0C1\uC810 \uD328\uB110\uC744 \uD1B5\uD574 \uC544\uC774\uD15C\uACFC \uAE30\uBB3C\uC744
    \uAD6C\uB9E4\uD560 \uC218 \uC788\uB2E4. \uC0C1\uB2E8\uC758 \uD06C\uB808\uB527\uC774
    \uC18C\uBAA8\uB41C\uB2E4."
  moveDescription: "- \uAE30\uBB3C\uC744 \uD074\uB9AD\uD574 \uAE30\uBB3C\uC758 \uC815\uBCF4\uB97C
    \uD655\uC778\uD560 \uC218 \uC788\uB2E4.\n- \uC774\uB3D9 : \uAE30\uBB3C\uC744
    \uB4DC\uB798\uADF8\uD55C\uB2E4.\n- \uC2A4\uD0AC : \uC778\uBCA4\uD1A0\uB9AC \uC544\uC774\uD15C,
    \uAE30\uBB3C\uC758 \uC815\uBCF4\uC5D0\uC11C \uC0AC\uC6A9\uD560 \uC218 \uC788\uB2E4.\n-
    \uBA85\uB839\uC774 \uC785\uB825\uB418\uBA74 \uD589\uB3D9\uB825\uC774 1 \uCC28\uAC10\uB41C\uB2E4.
    \uD589\uB3D9\uB825\uC774 0\uC77C \uACBD\uC6B0 \uC624\uB798\uB41C \uBA85\uB839\uC774
    \uC0AD\uC81C\uB41C\uB2E4.\n*\uBAA8\uB4E0 \uBA85\uB839\uC740 \uD134 \uC885\uB8CC
    \uC2DC \uC2E4\uD589\uB41C\uB2E4. "
  skillDescription: "- \uD074\uB9AD\uC744 \uD1B5\uD574 \uAE30\uBB3C\uC744 \uC120\uD0DD\uD558\uAC70\uB098
    \uD0C0\uC77C\uC744 \uC120\uD0DD\uD560 \uC218 \uC788\uB2E4.\n- \uCDE8\uC18C \uBC84\uD2BC\uC744
    \uB20C\uB7EC \uC2A4\uD0AC\uC744 \uCDE8\uC18C\uD560 \uC218 \uC788\uB2E4.\n- \uD45C\uC2DC\uAC00
    \uB41C \uD0C0\uC77C, \uAE30\uBB3C\uB9CC \uC120\uD0DD\uD560 \uC218 \uC788\uB2E4.\n-
    \uC2A4\uD0AC \uC785\uB825\uC774 \uC644\uB8CC\uB418\uBA74 \uD589\uB3D9\uB825\uC774
    1 \uCC28\uAC10\uB418\uACE0, \uD589\uB3D9\uB825\uC774 0\uC77C \uACBD\uC6B0 \uC624\uB798\uB41C
    \uBA85\uB839\uC774 \uC0AD\uC81C\uB41C\uB2E4."
  defaultDescription: "- \uD604\uC7AC \uD589\uB3D9 \uBD88\uAC00\n- \uC6B0\uD074\uB9AD
    \uB4DC\uB798\uADF8\uB85C \uD654\uBA74\uC758 \uAC01\uB3C4\uB97C \uC870\uC808\uD560
    \uC218 \uC788\uC2B5\uB2C8\uB2E4."
